<?xml version="1.0" ?>
<pqevents>
  <!--
     In this test we want to make sure for two things:
      1) Aspect ratio of the generated preview is same (up to integer rounding error) with the target resolution
      2) Size fills up the window area. Since this is non-trivial test we check size against some precomputed values extracted by running the test locally.
  -->

  <!-- Setup data -->
  <pqevent object="pqClientMainWindow/menubar" command="activate" arguments="menuSources" />
  <pqevent object="pqClientMainWindow/menubar/menuSources/Alphabetical" command="activate" arguments="RTAnalyticSource" />
