<?xml version="1.0" ?>
<pqevents>
  <pqevent object="pqClientMainWindow/menubar" command="activate" arguments="menuTools" />
  <pqevent object="pqClientMainWindow/menubar/menuTools" command="activate" arguments="actionTesting_Window_Size_Custom" />
  <pqevent object="pqClientMainWindow/pqLockViewSizeCustomDialog/Width" command="key" arguments="16777219" />
  <pqevent object="pqClientMainWindow/pqLockViewSizeCustomDialog/Width" command="set_string" arguments="400" />
  <pqevent object="pqClientMainWindow/pqLockViewSizeCustomDialog/Height" command="key" arguments="16777219" />
  <pqevent object="pqClientMainWindow/pqLockViewSizeCustomDialog/Height" command="set_string" arguments="400" />
  <pqevent object="pqClientMainWindow/pqLockViewSizeCustomDialog/ButtonBox/1QPushButton0" command="activate" arguments="" />
  <pqevent object="pqClientMainWindow/axesToolbar/actionShowOrientationAxes" command="set_boolean" arguments="false" />

  <!-- This test checks the enable / disable state of the Zoom To Data and Zoom Closest To Data buttons depending on the visibility of the source / view / representation and the data pieces if data is composite. It also checks that the zoom to data zoom only on the visible pieces of the composite data. -->
  <pqevent object="pqClientMainWindow/MainControlsToolbar/actionOpenData" command="activate" arguments="" />
  <pqevent object="pqClientMainWindow/FileOpenDialog" command="filesSelected" arguments="$PARAVIEW_DATA_ROOT/Testing/Data/mb_with_pieces.vtm" />
  <pqevent object="pqClientMainWindow/propertiesDock/propertiesPanel/Accept" command="activate" arguments="" />

  <!-- Open the multiblock inspector -->
  <pqevent object="pqClientMainWindow/menubar" command="activate" arguments="menu_View" />
  <pqevent object="pqClientMainWindow/menubar/menu_View" command="activate" arguments="Multi-block Inspector" />

  <!-- Hide all blocks -->
  <pqevent object="pqClientMainWindow/multiBlockInspectorDock/multiBlockInspectorPanel/container/1pqProxyWidget0/DataAssemblyEditor/tabWidget/qt_tabwidget_stackedwidget/hierarchyTab/hierarchy" command="setCheckState" arguments="0.0.0.0,0" />
  <pqevent object="pqClientMainWindow/multiBlockInspectorDock/multiBlockInspectorPanel/container/1pqProxyWidget0/DataAssemblyEditor/tabWidget/qt_tabwidget_stackedwidget/hierarchyTab/hierarchy" command="setCheckState" arguments="0.0.1.0,0" />

  <!-- Check that Zoom To Data buttons are disabled -->
  <!-- 1QToolButton1 is the button for action actionZoomToData -->
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton1" property="enabled" arguments="false" />
  <!-- 1QToolButton3 is the button for action actionZoomClosestToData -->
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton3" property="enabled" arguments="false" />

  <!-- Activate only one piece and zoom on it-->
  <pqevent object="pqClientMainWindow/multiBlockInspectorDock/multiBlockInspectorPanel/container/1pqProxyWidget0/DataAssemblyEditor/tabWidget/qt_tabwidget_stackedwidget/hierarchyTab/hierarchy" command="setCheckState" arguments="0.0.1.0.0.0,2" />
  <pqevent object="pqClientMainWindow/cameraToolbar/actionZoomToData" command="activate" arguments="" />
  <pqcompareview object="pqClientMainWindow/centralwidget/MultiViewWidget/CoreWidget/qt_tabwidget_stackedwidget/MultiViewWidget1/Container/Frame.0/CentralWidgetFrame/Viewport" baseline="$PARAVIEW_DATA_ROOT/Clients/ParaView/Testing/Data/Baseline/ZoomToData1.png" width="400" height="400" />

  <!-- Create a box -->
  <pqevent object="pqClientMainWindow/menubar" command="activate" arguments="menuSources" />
  <pqevent object="pqClientMainWindow/menubar/menuSources/Alphabetical" command="activate" arguments="CubeSource" />
  <pqevent object="pqClientMainWindow/propertiesDock/propertiesPanel/scrollArea/qt_scrollarea_viewport/scrollAreaWidgetContents/PropertiesFrame/ProxyPanel/Center/DoubleLineEdit0" command="set_string" arguments="2" />
  <pqevent object="pqClientMainWindow/propertiesDock/propertiesPanel/Accept" command="activate" arguments="" />
  <!-- Hide the box and checks that buttons are disabled -->
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mousePress" arguments="1,1,0,11,10,/0:0/1:1" />
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mouseRelease" arguments="1,0,0,11,10,/0:0/1:1" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton1" property="enabled" arguments="false" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton3" property="enabled" arguments="false" />

  <!-- Now show the box and check again buttons-->
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mousePress" arguments="1,1,0,9,10,/0:0/1:1" />
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mouseRelease" arguments="1,0,0,9,10,/0:0/1:1" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton1" property="enabled" arguments="true" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton3" property="enabled" arguments="true" />

  <!-- Now hide the other source and check that the buttons are still enabled -->
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mousePress" arguments="1,1,0,11,9,/0:0/0:1" />
  <pqevent object="pqClientMainWindow/pipelineBrowserDock/pipelineBrowser" command="mouseRelease" arguments="1,0,0,11,9,/0:0/0:1" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton1" property="enabled" arguments="true" />
  <pqcheck object="pqClientMainWindow/cameraToolbar/1QToolButton3" property="enabled" arguments="true" />

  <!--  Zoom on this box -->
  <pqevent object="pqClientMainWindow/cameraToolbar/actionZoomToData" command="activate" arguments="" />
  <pqcompareview object="pqClientMainWindow/centralwidget/MultiViewWidget/CoreWidget/qt_tabwidget_stackedwidget/MultiViewWidget1/Container/Frame.0/CentralWidgetFrame/Viewport" baseline="$PARAVIEW_DATA_ROOT/Clients/ParaView/Testing/Data/Baseline/ZoomToData2.png" width="400" height="400" />

</pqevents>
