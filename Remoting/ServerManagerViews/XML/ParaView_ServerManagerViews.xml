<ServerManagerConfiguration>
  <ProxyGroup name="views">
    <ViewProxy class="vtkPVRenderView"
               name="RenderView"
               processes="client dataserver renderserver">

      <IntVectorProperty command="SetSize"
                         default_values="1920 1163"
                         name="ViewSize"
                         number_of_elements="2"
                         panel_visibility="never"
                         processes="client renderserver" >
        <Documentation>
            Resolution to use when rendering images in this view.
        </Documentation>
      </IntVectorProperty>

      <ProxyProperty name="Representations"
                     command="SetRepresentations"
                     resizable="1">
        <Documentation>Representations in this view.</Documentation>
      </ProxyProperty>

      <Command name="Update" command="Update" />
    </ViewProxy>
  </ProxyGroup>

  <ProxyGroup name="representations">
    <Proxy class="vtkGeometryRepresentation"
           name="GeometryRepresentation"
           processes="client dataserver renderserver">
      <InputProperty command="SetInputConnection"
                     name="Input">
        <DataTypeDomain name="input_type">
          <DataType value="vtkDataSet" />
        </DataTypeDomain>
      </InputProperty>

      <IntVectorProperty name="Visibility"
        command="SetVisibility"
        number_of_elements="1"
        default_values="1">
        <BooleanDomain name="bool" />
        <Documentation>
          Visibility of the representation. A representation is shown in the view only
          when it is visible.
        </Documentation>
      </IntVectorProperty>

    </Proxy>
  </ProxyGroup>

  <!-- ==================================================================== -->
  <ProxyGroup name="misc">

    <!-- ================================================================== -->
    <ViewLayoutProxy name="ViewLayout"
                     class="vtkViewLayout"
                     processes="client|renderserver">
      <Documentation>Proxy used to manage layout for multiple views.</Documentation>
      <IntVectorProperty name="PreviewMode"
        number_of_elements="2"
        default_values="0 0">
        <Documentation>
          Set the target resolution for the preview mode to display,
          [0, 0] is interpreted as exiting preview.
        </Documentation>
      </IntVectorProperty>
      <IntVectorProperty name="SeparatorWidth"
        command="SetSeparatorWidth"
        number_of_elements="1"
        default_values="1">
        <IntRangeDomain name="range" min="0" max="10" />
        <Documentation>
          The width of the separator (in pixels) to be displayed in preview mode.
        </Documentation>
      </IntVectorProperty>
      <DoubleVectorProperty name="SeparatorColor"
        command="SetSeparatorColor"
        number_of_elements="3"
        default_values="0.937 0.922 0.906">
        <DoubleRangeDomain name="range" min="0 0 0" max="1 1 1" />
        <Documentation>
          The color of the separator to be displayed in preview mode.
        </Documentation>
      </DoubleVectorProperty>
    </ViewLayoutProxy>
  </ProxyGroup>

</ServerManagerConfiguration>
